# Server configuration
PORT=8080

# Set to "development" to skip serving embedded static files
# (use Vite dev server on port 5173 instead)
MODE=development

# Database — optional Postgres URL for migrations/tests. The self-hosted server
# normally uses SQLite via DATABASE_PATH (see below).
# DATABASE_URL=

# SQLite (self-hosted) — when DATABASE_PATH is set, the Go server uses embedded
# SQLite instead of DATABASE_URL. Requires SECRET_ENCRYPTION_KEY (32 random
# bytes, base64): openssl rand -base64 32
# DATABASE_PATH=/var/lib/permission-slip/app.db
# SECRET_ENCRYPTION_KEY=

# JWT for browser sessions — required in production. Generate with:
#   openssl rand -hex 32
# JWT_SIGNING_SECRET=

# Test database — used by "go test" and CI (Postgres)
DATABASE_URL_TEST=postgres://localhost:5432/permission_slip_test?sslmode=disable

# App backend database role — used when running against Postgres with RLS migrations
# DATABASE_URL_APP=

# API base URL — override the default "/api" prefix used by the frontend
# VITE_API_BASE_URL=/api/v1

# ── OAuth 2.0 Provider Credentials ───────────────────────────────────────────
#
# OAuth enables users to connect their Google, Microsoft, PagerDuty, Linear, or custom
# accounts so connectors can act on their behalf. Each provider needs a client
# ID and secret from the provider's developer console.
#
# Built-in providers (Google, Microsoft, PagerDuty, Linear, etc.) use these env vars.
# If not set, the providers are registered but marked as unconfigured and
# their OAuth flows will not work.
#
# Airtable — create at https://airtable.com/create/oauth
# Configure scopes: data.records:read, data.records:write, data.recordComments:read, data.recordComments:write, schema.bases:read, schema.bases:write
# Set callback URL: https://<domain>/api/v1/oauth/airtable/callback
# AIRTABLE_CLIENT_ID=
# AIRTABLE_CLIENT_SECRET=
#
# Google — create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Meta (Facebook/Instagram) — create at https://developers.facebook.com/apps/
# META_CLIENT_ID=
# META_CLIENT_SECRET=
#
# Microsoft — create at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
#
# Salesforce — create a Connected App at https://developer.salesforce.com/
# Configure OAuth scopes: api, refresh_token
# Set callback URL: https://<domain>/api/v1/oauth/salesforce/callback
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
#
# Discord — create at https://discord.com/developers/applications
# Configure OAuth2 redirects: https://<domain>/api/v1/oauth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
#
# LinkedIn — create at https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
#
# PagerDuty — create at https://developer.pagerduty.com/
# Configure scopes: read, write
# Set callback URL: https://<domain>/api/v1/oauth/pagerduty/callback
# PAGERDUTY_CLIENT_ID=
# PAGERDUTY_CLIENT_SECRET=
#
# PayPal — Log in with PayPal at https://developer.paypal.com/dashboard/
# Enable required REST API features (Payouts, Invoicing, etc.) on the app.
# Set Return URL: https://<domain>/api/v1/oauth/paypal/callback
# Sandbox: use https://www.sandbox.paypal.com/signin/authorize and
# https://api.sandbox.paypal.com/v1/oauth2/token only if you register a
# separate sandbox app; the built-in provider uses live PayPal OAuth endpoints.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
#
# Kroger — create at https://developer.kroger.com/
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
#
# Linear — create at https://linear.app/settings/api/applications
# Configure OAuth scopes: read, write
# Set callback URL: https://<domain>/api/v1/oauth/linear/callback
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
#
# DocuSign — create at https://developers.docusign.com/
# Configure OAuth scopes: signature
# Set callback URL: https://<domain>/api/v1/oauth/docusign/callback
# DOCUSIGN_CLIENT_ID=
# DOCUSIGN_CLIENT_SECRET=
#
# Dropbox — create at https://www.dropbox.com/developers/apps
# Configure OAuth scopes: files.content.write, files.content.read, sharing.write, file_requests.read
# Set callback URL: https://<domain>/api/v1/oauth/dropbox/callback
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
#
# Shopify — create a custom app at https://partners.shopify.com/ or your store admin
# Configure OAuth scopes as needed (e.g. read_products, write_orders)
# Set callback URL: https://<domain>/api/v1/oauth/shopify/callback
# Note: Shopify OAuth is per-store — users supply their subdomain at connect time
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
#
# Slack — create at https://api.slack.com/apps → OAuth & Permissions
# Set redirect URL: https://<domain>/api/v1/oauth/slack/callback
# Add bot and user scopes per docs/oauth-setup.md (Slack OAuth Setup)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
#
# Zendesk — create an OAuth client at https://<subdomain>.zendesk.com/admin/apps-integrations/apis/apis/oauth_clients
# Configure OAuth scopes: read, write
# Set callback URL: https://<domain>/api/v1/oauth/zendesk/callback
# Note: Zendesk OAuth is per-subdomain — users supply their subdomain at connect time
# ZENDESK_CLIENT_ID=
# ZENDESK_CLIENT_SECRET=
#
# Calendly — create at https://developer.calendly.com/
# Set callback URL: https://<domain>/api/v1/oauth/calendly/callback
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
#
# OAuth redirect base URL — override the base URL used for OAuth callback URLs.
# Defaults to BASE_URL. Only needed when the public-facing URL differs from
# the internal BASE_URL (e.g. behind a reverse proxy or tunnel).
# OAUTH_REDIRECT_BASE_URL=
#
# OAuth state secret — HMAC-SHA256 key for signing CSRF state tokens during
# the OAuth authorization flow. Falls back to JWT_SIGNING_SECRET if not set.
# For production, set a dedicated secret: openssl rand -hex 32
# OAUTH_STATE_SECRET=
#
# OAuth token refresh interval — how often the background job checks for
# tokens expiring soon. Tokens within 15 minutes of expiry are proactively
# refreshed. Accepts Go duration format (e.g., "10m", "5m"). Minimum: 1m.
# OAUTH_REFRESH_INTERVAL=10m

# Allowed CORS origins — comma-separated list of origins permitted to make
# cross-origin requests to the API. When empty, the server operates in
# "same-origin only" mode: requests whose Origin matches the server's own
# Host are allowed; all other cross-origin requests are blocked.
# Example: https://permission-slip.example.com,https://openclaw.example.com
#
# For local dev with ngrok or any external tunnel:
# ALLOWED_ORIGINS=https://your-subdomain.ngrok-free.app
ALLOWED_ORIGINS=

# Public base URL — used to construct invite URLs for agent registration
# Example: https://permission-slip.example.com
BASE_URL=

# HMAC key for hashing invite codes — if set, uses HMAC-SHA256 instead of plain SHA-256
# Generate with: openssl rand -hex 32
INVITE_HMAC_KEY=

# Credential vault encryption (AES-256-GCM). Generate with: openssl rand -hex 32
VAULT_SECRET_KEY=your-vault-secret-key-from-openssl-rand

# Trusted proxy header — the HTTP header used to extract the real client IP
# when running behind a reverse proxy. Default: "X-Forwarded-For".
# Set to empty string to disable and use RemoteAddr directly.
# TRUSTED_PROXY_HEADER=X-Forwarded-For

# Graceful shutdown timeout — how long the server waits for in-flight requests
# to complete before force-closing. Accepts Go duration syntax (e.g. "30s", "1m").
# Default: 30s
# SHUTDOWN_TIMEOUT=30s

# Audit log purge interval — how often the server runs `purge_expired_audit_events()`
# to delete audit events older than AUDIT_RETENTION_DAYS (default 90).
# Accepts Go duration syntax. Minimum: 1m. Default: 1h
# AUDIT_PURGE_INTERVAL=1h

# Maximum age of audit events in days (default 90). Used by the Go purge job
# and should match the SQL interval in `purge_expired_audit_events()`.
# AUDIT_RETENTION_DAYS=90

# Default TTL applied to new approval requests when the agent does not pass an
# `expires_in` override. Accepts Go duration syntax (e.g., "10m", "1h").
# Clamped to [1m, 24h]; invalid or out-of-bounds values fall back to 10m.
# APPROVAL_REQUEST_TTL=10m

# Custom connectors — override the directory where external connectors are
# installed and loaded from. Defaults to ~/.permission_slip/connectors/.
# On platforms like Heroku, set this to a path inside the app slug (e.g. /app/connectors)
# so connectors survive dyno restarts.
# CONNECTORS_DIR=

# Custom connectors — provide the connector list as inline JSON instead of
# requiring a custom-connectors.json file on disk. When set, the
# install-connectors command reads from this env var instead of the file.
# Example: CUSTOM_CONNECTORS_JSON={"connectors":[{"repo":"https://github.com/acme/ps-jira-connector","ref":"v1.0.0"}]}
# CUSTOM_CONNECTORS_JSON=

# Notifications
#
# Each notification channel is enabled by setting its required env vars.
# When no channel env vars are set, the server starts with notifications
# disabled (a warning is logged at startup).

# ── Email (pick one provider) ────────────────────────────────────────────────
#
# Twilio SendGrid (recommended — single API key, no SMTP config):
# NOTIFICATION_EMAIL_PROVIDER=twilio-sendgrid
# SENDGRID_API_KEY=SG.xxxx
# NOTIFICATION_EMAIL_FROM=approvals@mycompany.com
#
# Generic SMTP (Gmail app password, Mailgun, self-hosted Postfix, etc.):
# NOTIFICATION_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=me@gmail.com
# SMTP_PASSWORD=app-password-here
# NOTIFICATION_EMAIL_FROM=me@gmail.com

# ── Mobile Push (Expo) ───────────────────────────────────────────────────────
#
# Mobile push notifications are sent via the Expo Push Service. The sender is
# enabled when the database is available; it reads Expo push tokens registered
# by the mobile app on login.
#
# EXPO_ACCESS_TOKEN must be from the SAME Expo project as the app on the phone.
# - App Store build: needs a token for @supersuit-tech/permission-slip (your
#   personal Expo token will get 403). See docs/deployment-self-hosted.md.
# - Your own EAS build: use your Expo account token (enable push permission).
#
# Create at https://expo.dev/settings/access-tokens (enable push notifications).
# See docs/deployment-self-hosted.md § Mobile Push Notifications.
#
# EXPO_ACCESS_TOKEN=

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────
#
# When SENTRY_DSN is not set, Sentry is disabled (no-op in dev/test).
# The free tier includes 5,000 errors/month and 10,000 performance
# transactions/month. Only 5xx errors and panics are captured — 4xx client
# errors are not reported.
#
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# CSP violation reporting — optional. When set, the server adds a report-uri
# directive to the Content-Security-Policy header so CSP violations are
# captured as Sentry events. Get the URL from your Sentry project:
# Settings → Security Headers → report-uri.
# SENTRY_CSP_ENDPOINT=https://o0.ingest.sentry.io/api/0/security/?sentry_key=abc

# ── Cloudflare Web Analytics ──────────────────────────────────────────────────
#
# When your domain is proxied through Cloudflare, Cloudflare Web Analytics
# auto-injects a beacon.min.js script. Set this to "true" to add the
# required CSP exceptions (script-src + connect-src). Not needed for local dev.
# CLOUDFLARE_INSIGHTS=true

# ── Product Analytics (PostHog) ─────────────────────────────────────────────
#
# PostHog is disabled when VITE_POSTHOG_KEY is not set.
#
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
#
# Backend CSP — must match VITE_POSTHOG_HOST so the browser can send
# events. Only needed in production (Vite dev server has no CSP).
# POSTHOG_HOST=https://us.i.posthog.com

# VITE_REACT_DEVTOOLS=true  # Uncomment to connect to standalone react-devtools app (npm run devtools)
